# PostgreSQL (Docker Compose defaults)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_DB_TEST=app_test

# Backend
PORT=3333
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_URL_TEST=postgresql://app:app@localhost:5432/app_test
# Prisma CLI (migrate deploy). Local/Docker: same as DATABASE_URL.
# Production (Neon): direct connection string (no -pooler in host).
DIRECT_URL=postgresql://app:app@localhost:5432/app

# Auth — required; do not use defaults in production
JWT_SECRET=change-me-use-long-random-string
AUTH_EMAIL=your-email@example.com
AUTH_PASSWORD=change-me-strong-password

# Frontend origin for CORS (comma-separated for multiple Vercel URLs)
FRONTEND_URL=http://localhost:5173

# Login rate limit (failed attempts per IP)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
JSON_BODY_LIMIT=1mb

# Frontend (build-time on Vercel)
# Production example: https://aula-marcada-api.onrender.com
VITE_API_URL=http://localhost:3333

# Docker Compose ports
BACKEND_PORT=3333
FRONTEND_PORT=5173
