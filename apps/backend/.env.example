PORT=3333
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_URL_TEST=postgresql://app:app@localhost:5432/app_test

# Prisma CLI (migrate deploy). Local/Docker: same as DATABASE_URL.
# Production (Neon): use the direct connection string (no -pooler in host).
DIRECT_URL=postgresql://app:app@localhost:5432/app

# Production (Neon): DATABASE_URL = pooled (?sslmode=require), DIRECT_URL = direct

# Auth — use strong unique values in production
JWT_SECRET=change-me-use-long-random-string
AUTH_EMAIL=your-email@example.com
AUTH_PASSWORD=change-me-strong-password

# Frontend origin for CORS (comma-separated for multiple origins)
# Example: https://aula-marcada.vercel.app
FRONTEND_URL=http://localhost:5173

# Login rate limit (failed attempts per IP)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
JSON_BODY_LIMIT=1mb
